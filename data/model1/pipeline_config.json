{
    "project_settings": {
        "gravity_file": "model1_grav.csv",
        "magnetic_file": "model1_mag.csv"
    },

    "data_columns": {
        "easting_col": "X",
        "northing_col": "Y",
        "upwards_col": "Z",
        "field": "obs"
    },
    
    "inversion_parameters": {
        "z_top": -200.0,
        "z_bottom": -1000.0,
        "incf": 45.0,
        "decf": 12.0,
        "incs": 45.0,
        "decs": 12.0,
        "reg_min": 1e-6,
        "reg_max": 1e2,
        "steps": 20
    },


    "magnetic_transformations": {
        "upward_continuation": {
            "execute": true,
            "dz": 500
        },
        "reduction_to_pole": {
            "execute": true,
            "inc_new": 90,
            "dec_new": 0
        }
    },
    "gravity_transformations": {
        "upward_continuation": {
            "execute": false,
            "dz": 200
        }
    },
    "joint_analysis": {
        "poisson_ratio": {
            "execute": true,
            "density_threshold": 0.05,
            "mu0_min": 1e-6,
            "mu0_max": 1e4,
            "steps": 30
        }
    }
}